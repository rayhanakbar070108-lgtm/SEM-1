sepatuA = 400000
sepatuB = 350000

hasilsepatuA = sepatuA - (sepatuA * 13//100)
hasilsepatuB = sepatuB - (sepatuB * 21//100)

print(f"Harga sepatu A adalah {sepatuA}")
print(f"harga sepatu B adalah {sepatuB}")
print(f"Sepatu A mendapat diskon 13% sehingga harganya menjadi {hasilsepatuA}")
print(f"Sepatu B mendapat diskon 21% sehingga harganya menjadi {hasilsepatuB}")