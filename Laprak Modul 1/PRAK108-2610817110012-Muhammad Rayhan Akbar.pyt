putaran = 5
jarak = 14
phi = 3.14

keliling = jarak / putaran
jari_jari = keliling / (2 * phi)

print(f"Diketahui :")
print(f"Pak Dengklek mengelilingi taman = {putaran}")
print(f"Putaran jarak tempuh Pak Dengklek = {jarak} kilometer")
print(f"\n")
print(f"Jawaban :")
print(f"Jari-jari taman yang dikelilingi Pak Dengklek adalah {jari_jari:.2f} kilometer")