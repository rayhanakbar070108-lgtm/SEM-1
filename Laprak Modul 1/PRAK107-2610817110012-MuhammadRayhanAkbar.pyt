a = 4
b = 5
c = 7
harga_tanah = 85000

keliling = a + b + c
total_biaya = keliling * harga_tanah

print(f"Diketahui :")
print(f"Panjang sisi segitiga berturut-turut adalah {a}, {b}, {c}")
print(f"Keliling tanah Pak Dengklek adalah {keliling}")
print(f"Harga tanah per meter adalah {harga_tanah}")
print(f"Jawabannya :")
print(f"Biaya yang diperlukan Pak Dengklek adalah : Rp {total_biaya}")