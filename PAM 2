NAMA = input("Masukkan NAMA anda:")
Nilai = int(input("Masukkan Nilainya: "))

if (Nilai >= 90):
    print(f"Grade {NAMA} adalah A")
elif(Nilai >= 80):
    print(f"Grade {NAMA} adalah B")
elif(Nilai >= 70):
    print(f"Grade {NAMA} adalah C")
elif(Nilai >= 60):
    print(f"Grade {NAMA} adalah D")
else:
    print(f"Grade {NAMA} adalah E")